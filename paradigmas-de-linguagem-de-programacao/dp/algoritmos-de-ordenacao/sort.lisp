(defun ff (lst)
    (let* ((lqual (quantif lst)))
    lqual))

(defun agrupa (lst) (agrupa* (cdr lst) (list (car lst))))

(defun agrupa* (lst lac)
    (cond (null lst) (list lac))
    (t (let* ((d1 (car lst))
             (d2 (car lac))
             (n1 (cadr d1))
             (n2 (card d2)))
        (cond ((eql n1 n2) (agrupa* (cdr lst)))
            (t (cons lac (agrupa* (cdr lst) ())))
        )         
    ))
)

(defun ms (lst)
    (cond (null lst) nil)
    ((null (cdr lst))
    (t (let* ((dupla (split lst))
        (l1 (car dupla))
        (l2 (card dupla)))
        (inter (ms l1))))
    ))